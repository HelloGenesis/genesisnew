enum VendorInvoiceStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

model VendorInvoice {
  id            String              @id @default(cuid())
  vendorId      String              @map("vendor_id")
  vendor        Account             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assignmentId  String?             @map("assignment_id")
  assignment    VendorAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  number        String
  amountPaise   Int                 @map("amount_paise")
  taxPaise      Int                 @default(0) @map("tax_paise")
  fileUrl       String?             @map("file_url")
  status        VendorInvoiceStatus @default(SUBMITTED)
  note          String?
  submittedById String?             @map("submitted_by_id")
  decidedById   String?             @map("decided_by_id")
  paidAt        DateTime?           @map("paid_at")
