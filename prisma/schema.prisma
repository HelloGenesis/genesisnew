  @@unique([vendorId, number])
  @@index([status])
  @@map("crm_vendor_invoices")
}

// --- Influencer database -----------------------------------------------------

enum Platform {
  INSTAGRAM
  YOUTUBE
  LINKEDIN
  X
  FACEBOOK
  MOJ
  JOSH
  SNAPCHAT
  OTHER
}

/// Follower bands: nano < 10K, micro < 100K, mid < 500K, macro < 1M, mega 1M+; celebrity by hand.
enum CreatorTier {
  NANO
  MICRO
  MID
  MACRO
  MEGA
  CELEBRITY
}

model Creator {
  id               String      @id @default(cuid())
  name             String
  handle           String
  platform         Platform    @default(INSTAGRAM)
  profileUrl       String?     @map("profile_url")
  followers        Int         @default(0)
  avgViews         Int?        @map("avg_views")
  /// Percent, e.g. 3.4.
  engagementRate   Float?      @map("engagement_rate")
  tier             CreatorTier @default(MICRO)
  niches           String[]    @default([])
  languages        String[]    @default([])
  city             String?
  gender           String?
  reelRatePaise    Int?        @map("reel_rate_paise")
  storyRatePaise   Int?        @map("story_rate_paise")
  postRatePaise    Int?        @map("post_rate_paise")
  email            String?
  phone            String?
  /// Agency or manager who represents them.
  managedBy        String?     @map("managed_by")
  notes            String?
  tags             String[]    @default([])
  blacklisted      Boolean     @default(false)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  campaigns        CampaignCreator[]

  @@unique([platform, handle])
  @@index([tier])
  @@index([city])
  @@map("crm_creators")
}

enum CampaignCreatorStatus {
  SHORTLISTED
  APPROACHED
  NEGOTIATING
  CONFIRMED
  CONTENT_RECEIVED
  APPROVED
  POSTED
  PAID
  DROPPED
}

/// A creator on an Influence campaign (an Influence project).
model CampaignCreator {
  id           String                @id @default(cuid())
  projectId    String                @map("project_id")
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId    String                @map("creator_id")
  creator      Creator               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status       CampaignCreatorStatus @default(SHORTLISTED)
  feePaise     Int?                  @map("fee_paise")
  deliverables String?
  postUrl      String?               @map("post_url")
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  reach        Int?
  postedAt     DateTime?             @map("posted_at")
  /// Shown to the client on the portal once the creator is confirmed.
  clientVisible Boolean              @default(true) @map("client_visible")
  notes        String?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@unique([projectId, creatorId])
  @@map("crm_campaign_creators")
}

// --- Integrations ------------------------------------------------------------

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Email, delivered by the job runner through Resend. A delivery failure never
/// touches the change it describes; it retries with backoff and staff can see it.
model EmailOutbox {
  id            String       @id @default(cuid())
  kind          String
  /// Recipients; empty with `toStaff` set means "every staff member in `staffScope`".
  to            String[]     @default([])
  toStaff       Boolean      @default(false) @map("to_staff")
  /// "all" | "sales" | "finance" | "producers"
  staffScope    String?      @map("staff_scope")
  subject       String
  text          String
  /// Same key twice = one email (a retried webhook never mails twice).
  dedupeKey     String?      @unique @map("dedupe_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  lastError     String?      @map("last_error")
  sentAt        DateTime?    @map("sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@map("crm_email_outbox")
}

/// A row that changed and should be mirrored to the CRM Google Sheet.
model SheetOutbox {
  id        String    @id @default(cuid())
  tab       String
  key       String
  deleted   Boolean   @default(false)
  changedAt DateTime  @default(now()) @map("changed_at")
  sentAt    DateTime? @map("sent_at")
  attempts  Int       @default(0)
  lastError String?   @map("last_error")

  @@unique([tab, key])
  @@index([sentAt])
  @@map("crm_sheet_outbox")
}

// --- Quotes and influencer plans (10 Oct 2026) ----------------------------------

enum QuoteKind {
  /// A price quote: plans, products, add-ons and custom lines.
  QUOTE
  /// An influencer plan: the creator list, with fees, for the client to approve.
  INFLUENCER_PLAN
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  PAID
  DECLINED
  EXPIRED
}

/// A quotation (like Genesis's Price Quote #0000039), sent from the CRM with a payment link.
model Quote {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  /// The secret in the client's link, /quote/<token>.
  token         String      @unique
  kind          QuoteKind   @default(QUOTE)
  status        QuoteStatus @default(DRAFT)
  title         String
  division      Division?
  accountId     String?     @map("account_id")
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  leadId        String?     @map("lead_id")
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  requestId     String?     @map("request_id")
  request       Request?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  contactName   String      @map("contact_name")
  contactEmail  String      @map("contact_email")
  contactPhone  String?     @map("contact_phone")
  company       String?
  issuedAt      DateTime    @default(now()) @map("issued_at")
  expiresAt     DateTime    @map("expires_at")
  notes         String?
  terms         String?
  /// GST added on top (the sample quote's prices are exclusive of GST).
  addGst        Boolean     @default(true) @map("add_gst")
  gstPercent    Int         @default(18) @map("gst_percent")
  discountPaise Int         @default(0) @map("discount_paise")
  subtotalPaise Int         @default(0) @map("subtotal_paise")
  taxPaise      Int         @default(0) @map("tax_paise")
  totalPaise    Int         @default(0) @map("total_paise")
  razorpayLinkId String?    @unique @map("razorpay_link_id")
  paymentUrl    String?     @map("payment_url")
  createdById   String?     @map("created_by_id")
  sentAt        DateTime?   @map("sent_at")
  viewedAt      DateTime?   @map("viewed_at")
  acceptedAt    DateTime?   @map("accepted_at")
  acceptedBy    String?     @map("accepted_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  lines         QuoteLine[]
  creators      QuoteCreator[]
  order         Order?
  projects      Project[]

  @@index([status, createdAt])
  @@index([accountId])
  @@index([leadId])
  @@map("crm_quotes")
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String  @map("quote_id")
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  /// "plan" | "product" | "addon" | "custom" | "creator"
  kind      String  @default("custom")
  productId String? @map("product_id")
  division  Division?
  title     String
  subtitle  String?
  /// One bullet per line.
  details   String?
  /// Smaller print under the bullets ("Shoot location and schedule to be mutually finalised.").
  note      String?
  qty       Int     @default(1)
  unitPaise Int     @default(0) @map("unit_paise")

  @@index([quoteId, position])
  @@map("crm_quote_lines")
}

/// A creator on an influencer plan, snapshotted so the plan the client approved never changes under them.
model QuoteCreator {
  id           String  @id @default(cuid())
  quoteId      String  @map("quote_id")
  quote        Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  creatorId    String? @map("creator_id")
  position     Int     @default(0)
  name         String
  handle       String
  platform     String
  profileUrl   String? @map("profile_url")
  followers    Int     @default(0)
  avgViews     Int?    @map("avg_views")
  niches       String[] @default([])
  city         String?
  deliverables String?
  feePaise     Int?    @map("fee_paise")

  @@map("crm_quote_creators")
}

// --- Google Drive (hello@genesismedia.co) ------------------------------------------

/// Who can see a project file. Genesis staff always can.
enum FileAudience {
  /// Genesis only — internal notes, costings, rough material.
  TEAM
  /// Genesis and the vendors on the project — raw footage, project files.
  TEAM_VENDOR
  /// Genesis and the client — drafts for review, finals.
  TEAM_CLIENT
  /// Genesis, the client and the project's vendors — briefs, scripts, references.
  EVERYONE
}

/// A file in a project's folder (raw, edited, first cut…), stored in Genesis's Google Drive and viewed in the CRM.
model DriveFile {
  id           String       @id @default(cuid())
  driveId      String       @unique @map("drive_id")
  name         String
  mimeType     String?      @map("mime_type")
  sizeBytes    BigInt?      @map("size_bytes")
  webViewLink  String?      @map("web_view_link")
  /// lib/crm/files FOLDERS key: brief, scripts, raw, avatar, first-cut, second-cut, final, internal.
  folder       String       @default("brief")
  audience     FileAudience @default(EVERYONE)
  projectId    String?      @map("project_id")
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accountId    String?      @map("account_id")
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  uploadedById String?      @map("uploaded_by_id")
  /// "staff" | "client" | "vendor"
  uploadedAs   String       @default("staff") @map("uploaded_as")
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  deliverables Deliverable[]

  @@index([projectId, folder, createdAt])
  @@index([accountId, createdAt])
  @@map("crm_drive_files")
}

/// Small encrypted settings the CRM keeps for itself — the Google Drive connection, Drive folder ids.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_settings")
}

// --- Company money: expenses, our own subscriptions, GST (Genesis, 12 Oct 2026) ---

enum ExpenseCategory {
  SALARY
  FREELANCER
  SOFTWARE
  RENT
  UTILITIES
  MARKETING
  PRODUCTION
  TRAVEL
  EQUIPMENT
  PROFESSIONAL_FEES
  TAXES
  OTHER
}

/// Money Genesis spends: salaries, vendors, rent, software, everything.
model Expense {
  id           String          @id @default(cuid())
  date         DateTime        @db.Date
  category     ExpenseCategory
  description  String
  /// Who was paid: the employee for a salary, otherwise the vendor.
  payee        String?
  amountPaise  Int             @map("amount_paise")
  /// Input GST on the bill, claimable against output GST.
  gstPaise     Int             @default(0) @map("gst_paise")
  paidVia      String?         @map("paid_via")
  reference    String?
  notes        String?
  projectId    String?         @map("project_id")
  createdById  String?         @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([date])
  @@index([category, date])
  @@map("crm_expenses")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

/// The tools and services Genesis itself pays for, with their renewal dates.
model CompanySubscription {
  id            String       @id @default(cuid())
  name          String
  vendor        String?
  category      String?
  amountPaise   Int          @map("amount_paise")
  cycle         BillingCycle @default(MONTHLY)
  nextDueDate   DateTime     @map("next_due_date") @db.Date
  autoRenew     Boolean      @default(true) @map("auto_renew")
  paymentMethod String?      @map("payment_method")
  ownerId       String?      @map("owner_id")
  notes         String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([active, nextDueDate])
  @@map("crm_company_subscriptions")
}

enum GstReturnStatus {
  PENDING
  FILED
  NOT_APPLICABLE
}

/// A GST return for a period (GSTR-1, GSTR-3B monthly; GSTR-9 yearly) and whether it is filed.
model GstFiling {
  id          String          @id @default(cuid())
  returnType  String          @map("return_type")
  /// "2026-09" for a month, "2025-26" for a financial year.
  period      String
  dueDate     DateTime        @map("due_date") @db.Date
  status      GstReturnStatus @default(PENDING)
  filedOn     DateTime?       @map("filed_on") @db.Date
  arn         String?
  taxPaidPaise Int?           @map("tax_paid_paise")
  notes       String?
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([returnType, period])
  @@index([status, dueDate])
  @@map("crm_gst_filings")
}

/// A brief taken from a new lead or an existing client, before it is quoted.
model Brief {
  id           String     @id @default(cuid())
  number       Int        @unique @default(autoincrement())
  title        String
  leadId       String?    @map("lead_id")
  accountId    String?    @map("account_id")
  division     Division?
  services     String[]   @default([])
  objective    String?
  audience     String?
  deliverables String?
  platforms    String[]   @default([])
  budgetPaise  Int?       @map("budget_paise")
  deadline     DateTime?  @db.Date
  references   String[]   @default([])
  notes        String?
  status       String     @default("NEW")
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([accountId])
  @@map("crm_briefs")
}

// --- Google, the inbox and notifications (Genesis, 12 Oct 2026) ---------------

/// A team member's own Google account, connected once: Gmail, Drive and Sheets, read-only.
model GoogleConnection {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  email        String
  /// Sealed (AES-GCM) refresh token.
  refreshToken String    @map("refresh_token")
  scopes       String
  status       String    @default("ACTIVE")
  lastError    String?   @map("last_error")
  /// Gmail historyId reached; null until the first scan.
  gmailCursor  String?   @map("gmail_cursor")
  /// Latest Drive modifiedTime processed.
  driveCursor  DateTime? @map("drive_cursor")
  lastSyncAt   DateTime? @map("last_sync_at")
  connectedAt  DateTime  @default(now()) @map("connected_at")

  @@map("crm_google_connections")
}

enum InboxSource {
  GMAIL
  DRIVE
  SHEET
  RAZORPAY
}

enum InboxKind {
  BRIEF
  CLIENT
  VENDOR
  INVOICE
  PROPOSAL
  LINK
  OTHER
}

enum InboxStatus {
  NEW
  DONE
  DISMISSED
}

/// Something found in a connected Gmail or Drive (or imported), sorted by the AI: a brief, client or vendor details, an invoice, a proposal, an important link.
model InboxItem {
  id          String      @id @default(cuid())
  /// "<source>:<user or org>:<external id>", so a message or file is only ever one item.
  dedupeKey   String      @unique @map("dedupe_key")
  userId      String?     @map("user_id")
  source      InboxSource
  externalId  String      @map("external_id")
  kind        InboxKind
  status      InboxStatus @default(NEW)
  confidence  Float?
  title       String
  sender      String?
  senderEmail String?     @map("sender_email")
  summary     String?
  url         String?
  links       String[]    @default([])
  /// What the AI pulled out: company, contact, budget, deliverables, GSTIN, amounts…
  data        Json?
  occurredAt  DateTime    @map("occurred_at")
  leadId      String?     @map("lead_id")
  briefId     String?     @map("brief_id")
  accountId   String?     @map("account_id")
  expenseId   String?     @map("expense_id")
  handledById String?     @map("handled_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([userId, status, occurredAt])
  @@index([status, kind])
  @@index([accountId])
  @@index([leadId])
  @@map("crm_inbox_items")
}

/// The bell in the CRM: one row per person per event.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("crm_notifications")
}

/// A Google Sheet brought into the CRM, and whether it is kept in sync.
model SheetImport {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  spreadsheetId String    @map("spreadsheet_id")
  sheetName     String    @map("sheet_name")
  title         String
  kind          String
  /// Column → field, as the AI (or a person) matched them.
  mapping       Json
  autoSync      Boolean   @default(false) @map("auto_sync")
  rowsImported  Int       @default(0) @map("rows_imported")
  lastRunAt     DateTime? @map("last_run_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([spreadsheetId, sheetName, kind])
  @@map("crm_sheet_imports")
}
