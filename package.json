{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:dev": "tsx scripts/dev-db.mts",
    "crm:seed": "tsx scripts/crm-seed.mts",
    "staff:grant": "tsx scripts/grant-staff.mts",
    "indexnow": "tsx scripts/indexnow.mts",
    "test:db": "tsx --conditions react-server --env-file=.env.development.local --test tests/*.test.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth0/nextjs-auth0": "^4.26.0",
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@sparticuz/chromium": "153.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "googleapis": "^174.0.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.1",
    "puppeteer-core": "25.12.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
